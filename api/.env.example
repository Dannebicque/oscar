# Copier en .env (non versionné) puis adapter. Ne jamais commiter de secret.
APP_ENV=dev
# Générer avec : php -r 'echo bin2hex(random_bytes(16)), PHP_EOL;'
APP_SECRET=
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost

# PostgreSQL (docker/dev) : les migrations ciblent PostgreSQL. Les tests utilisent SQLite en mémoire par défaut.
DATABASE_URL="postgresql://oscar:oscar-dev@127.0.0.1:5433/oscar?serverVersion=17&charset=utf8"
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'


# Connexion par CAS (serveur de l'établissement). Vide en local : utiliser la connexion de développement.
CAS_BASE_URL=https://cas.example.org/cas

# Clé de chiffrement des identifiants de comptes (hors base de données, jamais dans le dépôt).
# Générer : php -r 'echo "base64:".base64_encode(random_bytes(32)), PHP_EOL;'
APP_VAULT_KEY=

# Courriels envoyés par Oscar (réinitialisation de mot de passe, notifications par e-mail). null://null = rien n'est envoyé (développement).
# Production : smtp://utilisateur:motdepasse@smtp.exemple.fr:587
MAILER_DSN=null://null
MAILER_FROM=no-reply@oscar.local
# Adresse publique du front : lien du courriel de réinitialisation.
FRONT_URL=http://localhost:5173
# Tâches de fond (synchronisation, récaps, relances) : file en base.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# Comptes locaux (adresse + mot de passe) à côté du CAS. open | closed (fermer en production CAS seul).
APP_REGISTRATION=open

# Annuaire de l'établissement (LDAP, lecture seule). Vide = désactivé : la saisie des destinataires garde sa liste de démonstration.
LDAP_URL=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
# Attributs : nom, prénom et e-mail au minimum ; service et téléphone au choix de l'utilisateur.
LDAP_ATTR_FIRST=givenName
LDAP_ATTR_LAST=sn
LDAP_ATTR_MAIL=mail
LDAP_ATTR_DEPARTMENT=departmentNumber
LDAP_ATTR_PHONE=telephoneNumber
# Filtre supplémentaire facultatif, par exemple (objectClass=person)
LDAP_FILTER=
