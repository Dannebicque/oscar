# Modèle de configuration de production : copier en .env.prod (jamais versionné) et remplir. Voir docs/INSTALL.md.

# --- Obligatoire
# Nom de domaine public : Caddy obtient et renouvelle le certificat HTTPS tout seul. Laisser « :80 » pour un essai local sans HTTPS.
SERVER_NAME=oscar.exemple.fr
POSTGRES_PASSWORD=
# php -r 'echo bin2hex(random_bytes(16));'
APP_SECRET=
# Chiffre les mots de passe de messagerie. À sauvegarder À PART de la base : sans elle, les comptes ne se déchiffrent plus.
# php -r 'echo "base64:".base64_encode(random_bytes(32));'
APP_VAULT_KEY=
# Origine du front, utilisée pour les liens et le CORS (même origine : l'adresse publique, sans barre finale).
FRONT_URL=https://oscar.exemple.fr
CORS_ALLOW_ORIGIN='^https://oscar\.exemple\.fr$'
DEFAULT_URI=https://oscar.exemple.fr

# --- Connexion
# CAS de l'établissement (vide ou example.org : le bouton CAS n'apparaît pas).
CAS_BASE_URL=
# open : chacun peut créer un compte local ; closed : connexion par CAS seulement.
APP_REGISTRATION=closed

# --- Courriels envoyés par Oscar (réinitialisation de mot de passe, notifications par e-mail)
MAILER_DSN=smtp://utilisateur:motdepasse@smtp.exemple.fr:587
MAILER_FROM=oscar@exemple.fr

# --- Annuaire de l'établissement (facultatif)
LDAP_URL=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_ATTR_FIRST=givenName
LDAP_ATTR_LAST=sn
LDAP_ATTR_MAIL=mail
LDAP_ATTR_DEPARTMENT=departmentNumber
LDAP_ATTR_PHONE=telephoneNumber
LDAP_FILTER=

# --- Fixes
APP_SHARE_DIR=var/share
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
